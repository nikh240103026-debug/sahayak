# Copy to .env.local (web + scripts) and give the worker the same values it needs.
# Run `npm run keygen` to generate the three secrets, then `npm run doctor` to check everything.

# --- Web app -----------------------------------------------------------------
# Public URL of the web app, no trailing slash (http://localhost:3000 locally).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings -> API) ---------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key: safe in the browser, every table is protected by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key: server and worker only. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Encryption ----------------------------------------------------------------
# 32 random bytes, base64. `npm run keygen` generates one. Losing it makes stored profiles unreadable.
ENCRYPTION_KEY=
# Optional key rotation: bump the version for a new key and list old ones as version:base64,...
ENCRYPTION_KEY_VERSION=1
ENCRYPTION_PREVIOUS_KEYS=

# --- AI model (worker) ----------------------------------------------------------
# anthropic | gemini. Gemini has a free tier (free-tier prompts may be used by Google to improve its products: use only fictional sample documents).
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LLM_MODEL_AGENT=claude-sonnet-5-5
LLM_MODEL_FAST=claude-haiku-5-5
# Kill switch: true = no AI calls at all (manual entry and built-in recovery only).
LLM_DISABLED=false
# off | record | replay (replay uses fixtures/llm/*.json, used in CI and e2e)
LLM_FIXTURES=off

# --- Worker ----------------------------------------------------------------------
# Public URL of the worker container (for the /wake nudge). Leave empty to rely on polling only.
WORKER_URL=
# Shared HMAC secret for web -> worker calls. `npm run keygen` generates one.
WORKER_SHARED_SECRET=
# Port the worker listens on (most hosts set $PORT for you).
PORT=8080

# --- Cron ---------------------------------------------------------------------
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET` to /api/cron/retention.
CRON_SECRET=

# --- Portals ------------------------------------------------------------------
# Where the fictional demo portal lives (the web app itself): same as NEXT_PUBLIC_SITE_URL in most setups.
DEMO_PORTAL_BASE_URL=http://localhost:3000
# Comma-separated hosts the agent's browser may contact. Default: the demo portal host only.
ALLOWED_PORTAL_HOSTS=
# Real portals stay off. Each one would also need a reviewed workflow and a recorded terms check.
ENABLE_REAL_PORTALS=false
# memory = keep the demo portal's data in process memory (local tests only). Leave empty in deployments.
DEMO_PORTAL_STORE=

# --- Sign-in options ------------------------------------------------------------
# Show "Continue with Google" (configure the Google provider in Supabase first).
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false
# Clearly labelled demo-account shortcut for judges. Off by default.
NEXT_PUBLIC_ENABLE_DEMO_LOGIN=false
DEMO_LOGIN_EMAIL=
DEMO_LOGIN_PASSWORD=

# --- Limits and retention ---------------------------------------------------------
# Uploaded documents and screenshots are deleted after this many hours.
RETENTION_HOURS=24
MAX_RUNS_PER_USER_PER_DAY=5

# --- Contacts (shown on the Grievance page) ---------------------------------------
GRIEVANCE_EMAIL=
SUPPORT_EMAIL=

# --- Optional -----------------------------------------------------------------
# Error reporting DSN, if you add an error tracker. Leave empty for none.
SENTRY_DSN=
