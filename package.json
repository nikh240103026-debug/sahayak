{
  "name": "civic-assistant",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/shared",
    "apps/web",
    "apps/worker"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev -w @app/web",
    "dev:worker": "npm run dev -w @app/worker",
    "build": "npm run build -w @app/web && npm run build -w @app/worker",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p packages/shared && tsc --noEmit -p apps/worker && tsc --noEmit -p apps/web && tsc --noEmit -p scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "e2e:agent": "playwright test -c e2e/playwright.config.ts --project=agent",
    "doctor": "tsx scripts/doctor.ts",
    "keygen": "tsx scripts/keygen.ts",
    "smoke": "tsx scripts/smoke.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "sample-docs": "tsx scripts/generate-sample-docs.ts",
    "db:schema": "tsx scripts/build-schema.ts",
    "db:seed-sql": "tsx scripts/build-seed.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@supabase/supabase-js": "2.118.0",
    "@types/node": "24.19.2",
    "eslint": "9.39.5",
    "globals": "17.13.0",
    "pdf-lib": "1.17.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
